{
    "name": "droost/engine",
    "description": "Framework-free engine behind droost: the code index and its SQLite stores, the wiki and search cores, and the AI-harness installers and skill emitters.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.3",
        "nikic/php-parser": "^5.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "drupal/coder": "^8.3",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "suggest": {
        "ext-pdo_sqlite": "SQLite-backed code index: droost's on a site, bin/droost-index on a bare repository"
    },
    "autoload": {
        "psr-4": {
            "Droost\\Engine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Droost\\Engine\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "bin": [
        "bin/droost-index"
    ]
}
